{
    "name":  "@hoglet/sdk",
    "version":  "0.1.0",
    "description":  "Hoglet transaction builders (governance, locks, proposals, gauges). Signer-agnostic: never signs.",
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE",
                  "NOTICE"
              ],
    "license":  "Apache-2.0",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "prepublishOnly":  "tsc -p tsconfig.json"
                },
    "dependencies":  {
                         "@hoglet/core":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "typescript":  "^5.5.0"
                        },
    "publishConfig":  {
                          "access":  "public"
                      }
}
