{
    "name":  "@hoglet/mcp-server",
    "version":  "0.3.1",
    "description":  "Hoglet ecosystem MCP server (read-only) - DAOs, trading phases, bonding curves, gauges and AMM quotes on Supra",
    "homepage": "https://hoglet.xyz",
    "repository": {
        "type": "git",
        "url": "https://github.com/hoglet-DAO/hoglet-sdk.git",
        "directory": "packages/mcp"
    },
    "bugs": {
        "url": "https://github.com/hoglet-DAO/hoglet-sdk/issues"
    },
    "type":  "module",
    "main":  "dist/index.js",
    "bin":  {
                "hoglet-mcp":  "dist/index.js"
            },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "license":  "MIT",
    "scripts":  {
                    "clean":  "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
                    "build":  "pnpm run clean && tsc -p tsconfig.json",
                    "start":  "node dist/index.js",
                    "smoke":  "node smoke-test.mjs",
                    "prepublishOnly":  "pnpm run build"
                },
    "dependencies":  {
                         "@hoglet/core":  "workspace:*",
                         "@modelcontextprotocol/sdk":  "^1.12.0",
                         "zod":  "^3.24.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "typescript":  "^5.5.0"
                        },
    "engines":  {
                    "node":  ">=18.17"
                },
    "publishConfig":  {
                          "access":  "public"
                      }
}
