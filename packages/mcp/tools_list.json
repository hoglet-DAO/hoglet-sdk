{
  "tools": [
    {
      "name": "list_daos",
      "description": "List DAOs registered in the Hoglet index, with optional search, sort and pagination. Includes network metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Name or symbol fragment"
          },
          "verified": {
            "type": "boolean",
            "description": "Only verified DAOs"
          },
          "sort": {
            "type": "enum",
            "description": "Default tvl"
          },
          "order": {
            "type": "enum",
            "description": "Default desc"
          },
          "page": {
            "type": "number",
            "description": "Page (default 1)"
          },
          "limit": {
            "type": "number",
            "description": "Page size (default 12)"
          }
        }
      }
    },
    {
      "name": "get_dao_proposals",
      "description": "Indexed proposal history for a DAO (status, votes, metadata URI). Historical data lives off-chain; on-chain reads remain authoritative for live state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "daoAddress": {
            "type": "string",
            "description": "DAO account address"
          }
        },
        "required": [
          "daoAddress"
        ]
      }
    },
    {
      "name": "get_proposal_comments",
      "description": "Off-chain comments for a proposal id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "description": "Indexed proposal id (UUID)"
          }
        },
        "required": [
          "proposalId"
        ]
      }
    },
    {
      "name": "get_dao",
      "description": "Resolve a governance token to its DAO and return on-chain metadata plus curatorship/blessing status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tokenAddress": {
            "type": "string",
            "description": "Governance token FA metadata address"
          }
        },
        "required": [
          "tokenAddress"
        ]
      }
    },
    {
      "name": "get_dao_status",
      "description": "Governance status of a DAO: active, blessed, inflationary, guardian and factory curator. Explains what is blocked while under curatorship.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "daoAddress": {
            "type": "string",
            "description": "DAO account address"
          }
        },
        "required": [
          "daoAddress"
        ]
      }
    },
    {
      "name": "get_gauges",
      "description": "List a DAO's emission gauges with their staking token, votes and active state (inactive gauges reject votes).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "daoAddress": {
            "type": "string",
            "description": "DAO account address"
          },
          "epoch": {
            "type": "number",
            "description": "Epoch to read votes for (default: current)"
          }
        },
        "required": [
          "daoAddress"
        ]
      }
    },
    {
      "name": "get_gauge_active",
      "description": "Whether a gauge can receive votes/emissions. Birth-inactive gauges reject votes on-chain.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "daoAddress": {
            "type": "string",
            "description": "DAO account address"
          },
          "gaugeId": {
            "type": "number",
            "description": "Sequential gauge id"
          }
        },
        "required": [
          "daoAddress",
          "gaugeId"
        ]
      }
    },
    {
      "name": "get_epoch_info",
      "description": "Current Hoglet voting epoch (7-day epochs) and the final-24h voting lockout.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_token_metadata",
      "description": "Resolve an FA token's symbol, name, decimals and icon. Accepts Metadata or FungibleStore addresses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "faAddress": {
            "type": "string",
            "description": "FA metadata address or FungibleStore address"
          }
        },
        "required": [
          "faAddress"
        ]
      }
    },
    {
      "name": "get_trading_phase",
      "description": "Trading phase for a token: curve | migrating | amm | governance-only | unknown. Static DAOs are reported as governance-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tokenAddress": {
            "type": "string",
            "description": "Governance token FA metadata address"
          }
        },
        "required": [
          "tokenAddress"
        ]
      }
    },
    {
      "name": "get_curve_progress",
      "description": "Bonding-curve progress: quote token raised vs target threshold plus completion percentage (quote token may not be SUPRA).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tokenAddress": {
            "type": "string",
            "description": "Governance token FA metadata address"
          }
        },
        "required": [
          "tokenAddress"
        ]
      }
    },
    {
      "name": "quote_curve_buy",
      "description": "Quote how many governance tokens a quote-token amount buys on the bonding curve (pre-migration only).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tokenAddress": {
            "type": "string",
            "description": "Governance token FA metadata address"
          },
          "quoteAmount": {
            "type": "number",
            "description": "Amount of the pool quote token to spend, human units (e.g. 12.5)"
          }
        },
        "required": [
          "tokenAddress",
          "quoteAmount"
        ]
      }
    },
    {
      "name": "quote_amm_buy",
      "description": "Quote a post-migration AMM swap, including price impact vs the 1-unit reference rate (warn -10%, critical -25%).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "outputToken": {
            "type": "string",
            "description": "FA metadata address of the token you want"
          },
          "amountIn": {
            "type": "number",
            "description": "Input amount in human units"
          },
          "inputToken": {
            "type": "string",
            "description": "FA metadata paid (defaults to WSUP, the AMM wrapper side)"
          }
        },
        "required": [
          "outputToken",
          "amountIn"
        ]
      }
    },
    {
      "name": "get_curve_price",
      "description": "Current bonding-curve spot price (quote per whole token) for a launched token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tokenAddress": {
            "type": "string",
            "description": "Launched token metadata address"
          }
        },
        "required": [
          "tokenAddress"
        ]
      }
    },
    {
      "name": "get_hodl_stake",
      "description": "HODL staking position of a user in a launched token, plus pool totals (staked vs supply).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tokenAddress": {
            "type": "string",
            "description": "Launched token metadata address"
          },
          "userAddress": {
            "type": "string",
            "description": "User address"
          }
        },
        "required": [
          "tokenAddress",
          "userAddress"
        ]
      }
    },
    {
      "name": "get_contract_control",
      "description": "Who controls a deployed contract (dao_contracts_vault): admin, creator, EOA proxy, renouncement and cryptographic freeze status. Use this instead of treating a tombstone as immutable.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contractAddress": {
            "type": "string",
            "description": "Published package / managed account address"
          }
        },
        "required": [
          "contractAddress"
        ]
      }
    },
    {
      "name": "get_eoa_security_status",
      "description": "Security status of an EOA per the vault: unmanaged, permanently_renounced, dao_governed or hazard_key_still_active (renounce NOT effective).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eoaAddress": {
            "type": "string",
            "description": "Externally owned account address"
          }
        },
        "required": [
          "eoaAddress"
        ]
      }
    },
    {
      "name": "get_creator_contracts",
      "description": "Contracts deployed or donated by a creator, as recorded in the vault catalog.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "creatorAddress": {
            "type": "string",
            "description": "Creator address"
          },
          "limit": {
            "type": "number",
            "description": "Max entries (default 50)"
          }
        },
        "required": [
          "creatorAddress"
        ]
      }
    },
    {
      "name": "get_vault_contracts",
      "description": "Paginated public catalog of contracts managed by dao_contracts_vault (capped at 50 per page).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "number",
