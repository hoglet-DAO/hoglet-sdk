{
    "name":  "@hoglet/core",
    "version":  "0.2.1",
    "description":  "Hoglet shared addresses, network config, RPC clients and read helpers (Supra)",
    "homepage": "https://hoglet.xyz",
    "repository": {
        "type": "git",
        "url": "https://github.com/hoglet-xyz/hoglet-sdk.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/hoglet-xyz/hoglet-sdk/issues"
    },
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE",
                  "NOTICE"
              ],
    "license":  "Apache-2.0",
    "dependencies":  {
                         "@noble/hashes":  "^1.8.0"
                     },
    "scripts":  {
                    "clean":  "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
                    "build":  "pnpm run clean && tsc -p tsconfig.json",
                    "test":  "node --test test/config.test.mjs",
                    "prepublishOnly":  "pnpm run build"
                },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "typescript":  "^5.5.0"
                        },
    "engines":  {
                    "node":  ">=18.17"
                },
    "publishConfig":  {
                          "access":  "public"
                      }
}
