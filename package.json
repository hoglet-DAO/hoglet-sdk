{
    "name": "hoglet-sdk-monorepo",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Hoglet shared core, transaction SDK and MCP server for Supra",
    "license": "Apache-2.0",
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm run build && pnpm -r --if-present test",
        "smoke": "node packages/mcp/smoke-test.mjs",
        "smoke:launcher": "node packages/core/test/launcher.integration.mjs",
        "skills:validate": "node scripts/validate-skills.mjs",
        "skills:pack": "node scripts/pack-skills.mjs",
        "skills:ci": "pnpm skills:validate && pnpm skills:pack"
    },
    "engines": {
        "node": ">=18.17"
    },
    "packageManager": "pnpm@11.1.2",
    "devDependencies": {
        "archiver": "^8.0.0",
        "supra-l1-sdk": "^5.0.2",
        "supra-l1-sdk-core": "^2.0.1",
        "yaml": "^2.9.1"
    }
}
